# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
# NOTHING IN THIS FILE HAS A VALUE, AND THAT IS THE POINT.
#
# `next dev` never reads .env.example — Next loads .env, .env.local and
# .env.<mode>. A value written here is documentation that does nothing, and a
# secret written here is a secret in your git history. Set these in .env.local
# locally, and in the Vercel dashboard for deployments.
#
# There are no fallback defaults in the code either. A sibling of this project
# ships `ADMIN_PASSWORD = "Cef-33"` in committed source as an env-overridable
# default, which means the repository is the password. Here, an unset value
# disables the thing it configures rather than substituting a guessable one.

# The addresses that administer this directory — one or more, separated by
# commas. Compared case-insensitively against the address inside the signed
# session, and read from the environment on every admin page and every admin
# Server Action rather than stamped into the cookie. Removing an address
# therefore takes effect on the next request, not whenever an eight-hour
# session happens to expire.
#
# LEFT BLANK, NOBODY IS AN ADMINISTRATOR. That is deliberate: an unset
# variable must not match a blank address and hand /admin to the next visitor.
ADMIN_EMAILS=

# The administrator's password. Blank disables administrator sign-in outright.
# Both halves are required for /admin: the address must be on the list above
# AND this password must be typed.
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Session cookie signing key. Required in production; development falls back to
# a fixed insecure value so a fresh clone can be opened locally. Rotating it
# signs out every administrator and every doctor at once.
#   openssl rand -base64 48
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Data (Upstash Redis)
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Doctor records, the directory cache, advertisement
# creatives and the sign-in rate limiter all live here. Without it the
# catalogue falls back to fixtures — fine in development, quietly wrong on
# serverless, where the filesystem is per-instance and wiped by every deploy.
# Authentication does not fall back: no fixture holds a password hash.
#
# Either pair of names works. KV_* is what Vercel's integration injects;
# UPSTASH_* is what the Upstash console shows. Set ONE pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# This site's namespace inside a possibly shared database. Optional; defaults
# to `dp`. Upstash's REST API has no SELECT, so a URL and token address exactly
# one keyspace — two projects pointed at one database are kept apart by their
# key names and by nothing else.
#
# Set this to `dp-preview` on Vercel Preview deployments so a preview build
# cannot write into live data.
#
# Changing it after rows exist orphans them: the old keys stay in the database
# and nothing looks for them again. It is a name, not a tuning knob.
KV_PREFIX=dp

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
# blob | redis | url. Defaults to "blob" when BLOB_READ_WRITE_TOKEN is present,
# otherwise "redis", so a clone with only Upstash credentials still uploads.
#
# "blob" is the only thing in this project that talks to a third-party origin,
# and it costs exactly one entry in the CSP's img-src. "redis" stores images in
# the database and serves them from this origin, which needs no CSP entry at
# all but competes with the data for the 256MB free tier.
MEDIA_PROVIDER=

# Injected automatically by the Vercel Blob integration. Leave blank locally
# unless you are testing the blob provider.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, QR codes, the
# vCard's URL field and the sitemap — all of which are wrong if this is wrong,
# and none of which fail loudly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The address shown on /contact. Optional — the page omits the email line when
# this is blank rather than showing a made-up one.
NEXT_PUBLIC_CONTACT_EMAIL=
